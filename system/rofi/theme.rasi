* {
    bg: #1a1b26ff;
    bg-alt: #24283bff;
    fg: #c0caf5ff;
    accent: #7aa2f7ff;
    muted: #565f89ff;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 42%;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    background-color: @bg;
    padding: 12px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    text-color: @fg;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    margin: 10px 0 0 0;
}

element {
    border-radius: 6px;
    padding: 8px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}
