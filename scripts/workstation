#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_DIRECTORY="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "${SCRIPT_DIRECTORY}/.." && pwd)"

source "${REPO_ROOT}/scripts/lib/manifest.sh"

usage() {
  cat <<'EOF'
Usage:
  scripts/workstation bootstrap [--profile <id>]
  scripts/workstation status [--profile <id>]
  scripts/workstation phases [--profile <id>]
  scripts/workstation steps <phase> [--profile <id>]
  scripts/workstation run-step <phase> <step> [--profile <id>]
  scripts/workstation run-phase <phase> [--from <step>] [--plan] [--profile <id>]

Examples:
  scripts/workstation bootstrap
  scripts/workstation status
  scripts/workstation phases
  scripts/workstation steps 04-development
  scripts/workstation run-step 04-development 07-development-validation
  scripts/workstation run-phase 04-development --plan
  scripts/workstation run-phase 04-development --from 05-cli-tools
EOF
}

fail() {
  printf '[ERROR] %s\n' "$*" >&2
  exit 1
}

profile_id=""
command_name="${1:-}"
[[ -n "$command_name" ]] || { usage; exit 1; }
shift || true

phase_id=""
step_id=""
from_step=""
plan_only=false

case "$command_name" in
  bootstrap|status|phases)
    ;;
  steps|run-phase)
    phase_id="${1:-}"
    [[ -n "$phase_id" ]] || fail "A phase id is required."
    shift
    ;;
  run-step)
    phase_id="${1:-}"
    step_id="${2:-}"
    [[ -n "$phase_id" && -n "$step_id" ]] || fail "Phase and step ids are required."
    shift 2
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    fail "Unknown command: $command_name"
    ;;
esac

while (($# > 0)); do
  case "$1" in
    --profile)
      (($# >= 2)) || fail "Missing value for --profile."
      profile_id="$2"
      shift 2
      ;;
    --from)
      [[ "$command_name" == "run-phase" ]] || fail "--from is only valid with run-phase."
      (($# >= 2)) || fail "Missing value for --from."
      from_step="$2"
      shift 2
      ;;
    --plan)
      [[ "$command_name" == "run-phase" ]] || fail "--plan is only valid with run-phase."
      plan_only=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown argument: $1"
      ;;
  esac
done

discover_profile() {
  local profile_file_candidate
  local candidate_id
  local -a candidates=()

  for profile_file_candidate in "${REPO_ROOT}"/profiles/*/profile.yaml; do
    [[ -f "$profile_file_candidate" ]] || continue
    candidate_id="$(basename "$(dirname "$profile_file_candidate")")"
    candidates+=("$candidate_id")
  done

  case "${#candidates[@]}" in
    0)
      fail "No profile manifests were found under profiles/."
      ;;
    1)
      printf '%s\n' "${candidates[0]}"
      ;;
    *)
      fail "Multiple profiles are available (${candidates[*]}). Select one with --profile <id>."
      ;;
  esac
}

if [[ -z "$profile_id" ]]; then
  profile_id="$(discover_profile)"
fi

profile_root="${REPO_ROOT}/profiles/${profile_id}"
profile_file="${profile_root}/profile.yaml"
[[ -f "$profile_file" ]] || fail "Profile not found: $profile_id"

phase_file_for() {
  printf '%s/%s/phase.yaml\n' "$profile_root" "$1"
}

phase_declared() {
  local wanted="$1"
  local phase
  while IFS= read -r phase; do
    [[ "$phase" == "$wanted" ]] && return 0
  done < <(manifest_profile_phases "$profile_file")
  return 1
}

step_declared() {
  local phase_file="$1"
  local wanted="$2"
  local step
  while IFS= read -r step; do
    [[ "$step" == "$wanted" ]] && return 0
  done < <(manifest_phase_steps "$phase_file")
  return 1
}

phase_status_for() {
  local phase="$1"
  local phase_file
  local phase_status

  phase_file="$(phase_file_for "$phase")"
  if [[ -f "$phase_file" ]]; then
    phase_status="$(manifest_phase_field "$phase_file" status)"
    [[ -n "$phase_status" ]] || phase_status="implemented"
  else
    phase_status="planned"
  fi

  printf '%s\n' "$phase_status"
}

find_next_phase() {
  local phase
  local phase_status

  next_phase=""
  next_status=""

  while IFS= read -r phase; do
    phase_status="$(phase_status_for "$phase")"
    if [[ "$phase_status" != "validated" ]]; then
      next_phase="$phase"
      next_status="$phase_status"
      return 0
    fi
  done < <(manifest_profile_phases "$profile_file")
}

print_status_table() {
  local phase
  local phase_status

  printf '%-24s %-12s\n' 'Phase' 'Status'
  printf '%-24s %-12s\n' '------------------------' '------------'

  while IFS= read -r phase; do
    phase_status="$(phase_status_for "$phase")"
    printf '%-24s %-12s\n' "$phase" "$phase_status"
  done < <(manifest_profile_phases "$profile_file")
}

resolve_step() {
  local phase_file="$1"
  local step="$2"
  mode="$(manifest_step_field "$phase_file" "$step" mode)"
  entrypoint="$(manifest_step_field "$phase_file" "$step" entrypoint)"
  entrypoint_path=""
  if [[ -n "$entrypoint" ]]; then
    entrypoint_path="${profile_root}/${phase_id}/${entrypoint}"
  fi
}

execute_step() {
  local step="$1"
  local phase_file="$2"

  resolve_step "$phase_file" "$step"

  printf '\n============================================================\n'
  printf 'Phase: %s\nStep:  %s\nMode:  %s\n' "$phase_id" "$step" "${mode:-unknown}"
  printf '============================================================\n\n'

  if [[ "$mode" == "manual" ]]; then
    fail "Manual step reached: ${phase_id}/${step}. Follow its playbook, then resume with --from <next-step>."
  fi

  [[ -n "$entrypoint" ]] || fail "Step has no executable entrypoint: ${phase_id}/${step}"
  [[ -f "$entrypoint_path" ]] || fail "Entrypoint not found: $entrypoint_path"
  [[ -x "$entrypoint_path" ]] || fail "Entrypoint is not executable: $entrypoint_path"

  case "$mode" in
    validation|manual-validation)
      "$entrypoint_path"
      ;;
    *)
      if ((EUID == 0)); then
        "$entrypoint_path"
      else
        command -v sudo >/dev/null 2>&1 || fail "sudo is required to execute this step as root."
        sudo "$entrypoint_path"
      fi
      ;;
  esac
}

case "$command_name" in
  bootstrap)
    printf 'Linux Workstation bootstrap\n'
    printf '===========================\n\n'
    printf 'Repository: %s\n' "$REPO_ROOT"
    printf 'Profile:    %s\n\n' "$profile_id"

    print_status_table
    find_next_phase

    printf '\nNext action\n-----------\n'
    if [[ -z "$next_phase" ]]; then
      printf 'All declared phases are validated. No phase action is pending.\n'
    elif [[ "$next_status" == "planned" ]]; then
      printf 'Phase %s is planned but not implemented yet.\n' "$next_phase"
      printf 'No execution will be attempted. Add its phase manifest and playbooks before running it.\n'
    else
      printf 'Phase %s is %s and is the next actionable phase.\n' "$next_phase" "$next_status"
      printf 'Inspect the execution plan with:\n'
      printf '  ./scripts/workstation run-phase %s --plan --profile %s\n' "$next_phase" "$profile_id"
    fi

    printf '\nUseful commands\n---------------\n'
    printf '  make status\n'
    printf '  make validate-automation\n'
    [[ -n "$next_phase" && "$next_status" != "planned" ]] && printf '  make plan-phase PHASE=%s\n' "$next_phase"
    ;;

  status)
    printf 'Profile: %s\n\n' "$profile_id"
    print_status_table
    find_next_phase

    printf '\n'
    if [[ -n "$next_phase" ]]; then
      printf 'Next phase: %s (%s)\n' "$next_phase" "$next_status"
    else
      printf 'Next phase: none; all declared phases are validated.\n'
    fi
    ;;

  phases)
    printf 'Profile: %s\n\n' "$profile_id"
    while IFS= read -r phase; do
      phase_file="$(phase_file_for "$phase")"
      if [[ -f "$phase_file" ]]; then
        printf '%-24s available\n' "$phase"
      else
        printf '%-24s planned\n' "$phase"
      fi
    done < <(manifest_profile_phases "$profile_file")
    ;;

  steps)
    phase_declared "$phase_id" || fail "Phase is not declared by profile: $phase_id"
    phase_file="$(phase_file_for "$phase_id")"
    [[ -f "$phase_file" ]] || fail "Phase is planned but not implemented: $phase_id"

    printf 'Profile: %s\nPhase:   %s\n\n' "$profile_id" "$phase_id"
    while IFS= read -r step; do
      mode="$(manifest_step_field "$phase_file" "$step" mode)"
      entrypoint="$(manifest_step_field "$phase_file" "$step" entrypoint)"
      printf '%-32s %-18s %s\n' "$step" "${mode:-unknown}" "${entrypoint:-manual}"
    done < <(manifest_phase_steps "$phase_file")
    ;;

  run-step)
    phase_declared "$phase_id" || fail "Phase is not declared by profile: $phase_id"
    phase_file="$(phase_file_for "$phase_id")"
    [[ -f "$phase_file" ]] || fail "Phase is planned but not implemented: $phase_id"
    step_declared "$phase_file" "$step_id" || fail "Step is not declared in ${phase_id}: ${step_id}"
    execute_step "$step_id" "$phase_file"
    ;;

  run-phase)
    phase_declared "$phase_id" || fail "Phase is not declared by profile: $phase_id"
    phase_file="$(phase_file_for "$phase_id")"
    [[ -f "$phase_file" ]] || fail "Phase is planned but not implemented: $phase_id"

    if [[ -n "$from_step" ]]; then
      step_declared "$phase_file" "$from_step" || fail "Resume step is not declared in ${phase_id}: ${from_step}"
    fi

    printf 'Profile: %s\nPhase:   %s\n' "$profile_id" "$phase_id"
    [[ -n "$from_step" ]] && printf 'Resume:  %s\n' "$from_step"
    $plan_only && printf 'Mode:    plan only\n'
    printf '\n'

    started=false
    [[ -z "$from_step" ]] && started=true

    while IFS= read -r step; do
      if ! $started; then
        [[ "$step" == "$from_step" ]] || continue
        started=true
      fi

      resolve_step "$phase_file" "$step"

      if $plan_only; then
        printf '%-32s %-18s %s\n' "$step" "${mode:-unknown}" "${entrypoint:-manual}"
        continue
      fi

      execute_step "$step" "$phase_file"
    done < <(manifest_phase_steps "$phase_file")

    if ! $plan_only; then
      printf '\nPhase completed successfully: %s\n' "$phase_id"
    fi
    ;;
esac
